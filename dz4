class Animal:
    def __init__(self, name):
        self.name = name

    def speak(self):
        print("тварина видає звук")

class Dog(Animal):
    def speak(self):
        print(f"{self.name} каже: гав")

class Cat(Animal):
    def speak(self):
        print(f"{self.name} каже: мяу")

dog = Dog("буся")
cat = Cat("муська")

dog.speak()
cat.speak()
