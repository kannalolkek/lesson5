class Pet:
    def __init__(self, name, species):
        self.name = name
        self.species = species
        self.energy = 100
        self.hungry = False

    def play(self):
        if self.energy > 20:
            print(f"{self.name} грається!")
            self.energy -= 20
            self.hungry = True
        else:
            print(f"{self.name} втомився")

    def feed(self):
        if self.hungry:
            print(f"{self.name} їсть")
            self.hungry = False
            self.energy += 30
        else:
            print(f"{self.name} не голодний")

    def sleep(self):
        print(f"{self.name} спить...")
        self.energy = 100

pet = Pet("Лі", "кішка")
pet.play()
pet.feed()
pet.sleep()
